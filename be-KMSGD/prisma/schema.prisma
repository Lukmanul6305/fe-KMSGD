// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// AUTH
// =============================================================

model Admin {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("admins")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =============================================================
// BERANDA — SAMBUTAN
// =============================================================

model Sambutan {
  id        Int      @id @default(autoincrement())
  nama      String
  jabatan   String
  isi       String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sambutan")
}

// =============================================================
// STRUKTUR ORGANISASI — AKTIF & DEMISIONER
// =============================================================

model PeriodeOrganisasi {
  id         Int             @id @default(autoincrement())
  periode    String
  status     StatusPeriode   @default(AKTIF)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  pengurusInti PengurusInti[]
  departemen   Departemen[]
  kegiatan     Kegiatan[]

  @@map("periode_organisasi")
}

enum StatusPeriode {
  AKTIF
  DEMISIONER
}

// BPI / Pengurus Inti (Ketua, Wakil, Sekretaris, Bendahara)
model PengurusInti {
  id         Int               @id @default(autoincrement())
  periodeId  Int
  periode    PeriodeOrganisasi @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  nama       String
  jabatan    String            // "Ketua Umum", "Wakil Ketua Umum", dll
  slogan     String?           // Khusus Ketua Umum
  image      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("pengurus_inti")
}

model Departemen {
  id              Int               @id @default(autoincrement())
  periodeId       Int
  periode         PeriodeOrganisasi @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  namaDepartemen  String
  deskripsi       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  anggota  AnggotaDepartemen[]
  kegiatan Kegiatan[]

  @@map("departemen")
}

model AnggotaDepartemen {
  id            Int        @id @default(autoincrement())
  departemenId  Int
  departemen    Departemen @relation(fields: [departemenId], references: [id], onDelete: Cascade)
  nama          String
  jabatan       String     // "Ketua Divisi", "Anggota"
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("anggota_departemen")
}

// =============================================================
// KEGIATAN / PROGRAM
// =============================================================

model Kegiatan {
  id               Int                @id @default(autoincrement())
  periodeId        Int
  periode          PeriodeOrganisasi  @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime?
  kategoriId       Int
  kategori         KategoriKegiatan   @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  title            String
  desc             String
  location         String
  image            String?
  price            Int                @default(0)
  registrationLink String?
  departemenId     Int?
  departemen       Departemen?        @relation(fields: [departemenId], references: [id], onDelete: SetNull)
  organizerCustom  String?
  contactPerson    String?
  speakers         String[]
  isPenting        Boolean            @default(false)
  isPublished      Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  galeri           Galeri[]

  @@map("kegiatan")
}

model KategoriKegiatan {
  id         Int        @id @default(autoincrement())
  nama       String     @unique 
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  kegiatan   Kegiatan[]

  @@map("kategori_kegiatan")
}

// =============================================================
// PENGUMUMAN
// =============================================================

model Pengumuman {
  id          Int      @id @default(autoincrement())
  tanggal     DateTime
  kategoriId  Int
  kategori    KategoriPengumuman @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  title       String
  desc        String
  author      String
  image       String?
  isPenting   Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  persyaratan String[]
  berkas      String[]
  timeline    PengumumanTimeline[]
  linkPendaftaran String?
  contactPerson   String?

  @@map("pengumuman")
}

model PengumumanTimeline {
  id           Int        @id @default(autoincrement())
  pengumumanId Int
  pengumuman   Pengumuman @relation(fields: [pengumumanId], references: [id], onDelete: Cascade)
  agenda       String
  tanggal      String     // "10 - 31 Oktober 2025"

  @@map("pengumuman_timeline")
}

model KategoriPengumuman {
  id         Int        @id @default(autoincrement())
  nama       String     @unique 
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  pengumuman   Pengumuman[]

  @@map("kategori_pengumuman")
}

// =============================================================
// GALERI (foto & video)
// =============================================================

model Galeri {
  id         Int         @id @default(autoincrement())
  judul      String?
  tipe       GaleriTipe  // FOTO | VIDEO
  url        String      // URL gambar atau URL YouTube
  thumbnail  String?     // thumbnail override (untuk video)
  kegiatanId Int?        // opsional — galeri bisa berdiri sendiri
  kegiatan   Kegiatan?   @relation(fields: [kegiatanId], references: [id], onDelete: SetNull)
  isPublished Boolean    @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("galeri")
}

enum GaleriTipe {
  FOTO
  VIDEO
}

// =============================================================
// KONTAK
// =============================================================

model Kontak {
  id          Int      @id @default(autoincrement())
  email       String?
  whatsapp    String?
  instagram   String?
  alamat      String?
  googleMaps  String?  // embed URL Google Maps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kontak")
}
