{
  "info": {
    "name": "KMSGD API",
    "_postman_id": "kmsgd-api-collection",
    "description": "Koleksi endpoint API backend KMSGD. Base URL: http://localhost:3000/api\n\n🔐 Endpoint bertanda [AUTH] membutuhkan cookie `accessToken` yang didapat dari POST /auth/login.\nPostman otomatis menyimpan cookie jika 'Automatically follow redirects' dan cookie jar aktif.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login admin. Response set cookie accessToken & refreshToken."
          }
        },
        {
          "name": "Get Me [AUTH]",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] },
            "description": "Ambil data admin yang sedang login. Butuh cookie accessToken."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "description": "Refresh accessToken menggunakan refreshToken cookie."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "description": "Logout dan hapus cookie."
          }
        }
      ]
    },
